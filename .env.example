ISI_ENV=development
ISI_LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://isi_app:CHANGE_ME@localhost:5432/isi
REDIS_URL=redis://localhost:6379/0
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
PUBLIC_BASE_URL=http://localhost:8000
APP_BASE_URL=http://localhost:8501
POSTGRES_DB=isi
POSTGRES_USER=isi_app
POSTGRES_PASSWORD=CHANGE_ME_FOR_CONTAINER_DEPLOYMENT
AUTH_SESSION_TTL_SECONDS=43200
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
AUTH_INVITATION_TTL_SECONDS=604800
PUBLIC_PREVIEW_DRAFTS=false
API_BASE_URL=http://localhost:8000
DATA_STORAGE_BACKEND=local
DATA_STORAGE_ROOT=.isi-data
DATA_JOB_BACKEND=inline
DATA_MAX_UPLOAD_BYTES=16777216
DATA_MAX_XLSX_UNCOMPRESSED_BYTES=67108864
DATA_S3_BUCKET=
DATA_S3_ENDPOINT_URL=
AI_JOB_BACKEND=inline
AI_PROVIDER_DEFAULT=ollama
AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
AI_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
AI_REQUEST_TIMEOUT_SECONDS=120
AI_DEFAULT_POLICY=shared-local-only
AI_ALLOW_DEV_STUB=0
AI_STORE_REQUEST_TEXT=1
AUTH_SESSION_IDLE_TTL_SECONDS=3600
SECURITY_LOGIN_WINDOW_SECONDS=900
SECURITY_LOGIN_MAX_FAILURES=5
SECURITY_LOGIN_BLOCK_SECONDS=900
SECURITY_IDENTIFIER_PEPPER=
SECURITY_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
SECURITY_TRUST_PROXY_HEADERS=false
AUTH_DELIVERY_MODE=null

# ISI-15 deployment adapter settings. Keep real secrets out of Git.
ISI_DEPLOYMENT_PROFILE=development
DATA_S3_ACCESS_KEY_ID=
DATA_S3_SECRET_ACCESS_KEY=
DATA_S3_REGION=us-east-1
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_STARTTLS=false
SMTP_TIMEOUT_SECONDS=10
