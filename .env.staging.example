# Template only. Do not put real staging secrets in Git.
ISI_ENV=production
ISI_DEPLOYMENT_PROFILE=staging
ISI_LOG_LEVEL=INFO

# Runtime-generated in /tmp/isi15-staging for the local rehearsal.
POSTGRES_DB=isi15_staging
POSTGRES_USER=isi_app
POSTGRES_PASSWORD=GENERATE_AT_RUNTIME
DATABASE_URL=postgresql+psycopg://isi_app:GENERATE_AT_RUNTIME@postgres:5432/isi15_staging
REDIS_URL=redis://redis:6379/0

PUBLIC_BASE_URL=https://localhost:8443
APP_BASE_URL=https://localhost:8443/app
API_BASE_URL=http://api:8000
SECURITY_IDENTIFIER_PEPPER=GENERATE_AT_RUNTIME
SECURITY_ALLOWED_HOSTS=localhost,127.0.0.1,api
SECURITY_TRUST_PROXY_HEADERS=true
PUBLIC_PREVIEW_DRAFTS=false

DATA_STORAGE_BACKEND=s3
DATA_S3_BUCKET=isi15-staging
DATA_S3_ENDPOINT_URL=http://minio:9000
DATA_S3_ACCESS_KEY_ID=GENERATE_AT_RUNTIME
DATA_S3_SECRET_ACCESS_KEY=GENERATE_AT_RUNTIME
DATA_S3_REGION=us-east-1
DATA_JOB_BACKEND=rq
AI_JOB_BACKEND=rq

AUTH_DELIVERY_MODE=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_EMAIL=staging@isi.example
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_STARTTLS=false
SMTP_TIMEOUT_SECONDS=10

# External AI is not required by the ISI-15 staging acceptance.
AI_PROVIDER_DEFAULT=ollama
AI_OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_ALLOW_DEV_STUB=0

ISI15_HTTPS_PORT=8443
ISI15_MAILPIT_UI_PORT=8025
