# ISI target-server template. Do not commit real secrets.
# Pre-cutover runtime is generated on the Ubuntu server under /home/ubuntu/ISI/runtime.
ISI_ENV=production
ISI_DEPLOYMENT_PROFILE=staging
ISI_LOG_LEVEL=INFO

POSTGRES_DB=isi_preproduction
POSTGRES_USER=isi_app
POSTGRES_PASSWORD=GENERATE_ON_SERVER
DATABASE_URL=postgresql+psycopg://isi_app:GENERATE_ON_SERVER@postgres:5432/isi_preproduction
REDIS_URL=redis://redis:6379/1

PUBLIC_BASE_URL=https://isi.rs
APP_BASE_URL=https://isi.rs/app
API_BASE_URL=http://api:8000
SECURITY_IDENTIFIER_PEPPER=GENERATE_ON_SERVER
SECURITY_ALLOWED_HOSTS=isi.rs,www.isi.rs,localhost,127.0.0.1,api,streamlit
SECURITY_TRUST_PROXY_HEADERS=true
PUBLIC_PREVIEW_DRAFTS=false

DATA_STORAGE_BACKEND=s3
DATA_S3_BUCKET=isi-preproduction
DATA_S3_ENDPOINT_URL=http://minio:9000
DATA_S3_ACCESS_KEY_ID=GENERATE_ON_SERVER
DATA_S3_SECRET_ACCESS_KEY=GENERATE_ON_SERVER
DATA_S3_REGION=us-east-1
DATA_JOB_BACKEND=rq
AI_JOB_BACKEND=rq

# Pre-cutover email is captured by an internal Mailpit service only.
# ISI-16 replaces these values with the real production SMTP provider before DNS cutover.
AUTH_DELIVERY_MODE=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@isi.rs
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_STARTTLS=false
SMTP_TIMEOUT_SECONDS=10

AI_PROVIDER_DEFAULT=ollama
AI_OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_ALLOW_DEV_STUB=0

COMPOSE_PROJECT_NAME=isi
ISI_PRECUTOVER_HTTPS_PORT=8445
ISI_SERVER_ENV_FILE=/home/ubuntu/ISI/runtime/.env.server
ISI_POSTGRES_VOLUME=isi_postgres_data
ISI_REDIS_VOLUME=isi_redis_data
ISI_MINIO_VOLUME=isi_minio_data
ISI_MAILPIT_VOLUME=isi_mailpit_data
ISI_INTERNAL_NETWORK=isi_internal
ISI_INGRESS_NETWORK=isi_ingress
