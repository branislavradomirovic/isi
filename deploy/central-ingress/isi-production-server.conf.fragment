# ISI-16 template. Do not activate before production DB/SMTP/TLS/DNS gates pass.
server {
    listen 8443 ssl;
    server_name isi.rs www.isi.rs;
    server_tokens off;

    ssl_certificate /etc/nginx/isi-certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/isi-certs/privkey.pem;

    client_max_body_size 200M;

    resolver 127.0.0.11 valid=5s ipv6=off;
    resolver_timeout 2s;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    location = /app { return 308 /app/; }

    location /app/ {
        set $isi_streamlit_upstream isi-streamlit:8501;
        proxy_pass http://$isi_streamlit_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600;
        proxy_send_timeout 3600;
        proxy_buffering off;
    }

    location / {
        set $isi_api_upstream isi-api:8000;
        proxy_pass http://$isi_api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_read_timeout 3600;
        proxy_send_timeout 3600;
        proxy_buffering off;
    }
}
